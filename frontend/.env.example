# Copy to .env.local for local overrides. On Vercel, add the variable in Project → Settings → Environment Variables.

# Optional in development (default: empty — Vite dev server proxies /api to localhost:8000).
# Required for production static hosting (e.g. Vercel): origin of your FastAPI deployment, no trailing slash.
# VITE_API_URL=https://your-fastapi-host.example.com
